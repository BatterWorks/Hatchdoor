# Host-side Docker mounts. These paths are read by Docker Compose on the host.
# HOST_VAULT_PATH is your Markdown vault on the host machine.
HOST_VAULT_PATH=./vault
# HOST_CACHE_PATH stores Hatchdoor's generated SQLite cache on the host.
HOST_CACHE_PATH=./data/cache

# Container/runtime paths. In Docker, these should match the mounted container paths.
# For non-Docker cargo runs, set VAULT_PATH to your real local vault path instead.
VAULT_PATH=/data/vault
# HATCHDOOR_CACHE_DB should point outside the Markdown vault.
HATCHDOOR_CACHE_DB=/data/cache/hatchdoor-cache.sqlite3

# HTTP server bind settings for local `cargo run`.
# Docker Compose overrides HOST to 0.0.0.0 inside the container so the published
# port works. With that override, HATCHDOOR_WEB_BEARER_TOKEN must be set unless
# HATCHDOOR_DEMO_MODE=true.
HOST=127.0.0.1
PORT=42824

# Public read-only demo mode. Allows HOST=0.0.0.0 without web authentication,
# disables browser writes and manual reindexing, and refuses to start if MCP or
# git sync are enabled. Demo mode does NOT rate-limit anonymous requests
# (search embeds every query on CPU) — front a public demo with a rate-limiting
# reverse proxy.
HATCHDOOR_DEMO_MODE=false

# Web API authentication. When set, every /api/* request, asset, and download
# requires this token, sent either as `Authorization: Bearer <token>` or as an
# `access_token` query parameter (used by <img>/download links). Leave empty
# ONLY on a loopback bind (HOST=127.0.0.1) or in demo mode. A non-loopback HOST
# with no token refuses to start otherwise. Docker Compose binds non-loopback
# inside the container, so set this before `docker compose up` unless using demo
# mode. The bundled PWA shows a token prompt when the API returns 401.
HATCHDOOR_WEB_BEARER_TOKEN=

# Folder prefix treated as "archived" in resolve results (trailing slash).
HATCHDOOR_ARCHIVE_PREFIX=90-archive/

# MCP access. Disabled by default; enable only for trusted clients.
HATCHDOOR_MCP_ENABLED=false
# Write tools can create/edit/move/delete notes and attachments.
HATCHDOOR_MCP_WRITE_ENABLED=false
# Required whenever MCP is enabled (read-only or write). /mcp bypasses the web
# auth layer, so a missing token would expose the whole vault; Hatchdoor refuses
# to start if MCP is enabled without one.
HATCHDOOR_MCP_BEARER_TOKEN=
# Browser-originated MCP requests must come from one of these origins.
HATCHDOOR_MCP_ALLOWED_ORIGINS=http://127.0.0.1,http://localhost

# Attachment upload limits (bytes). Two upload paths, two caps:
#   - import_attachment MCP tool sends bytes base64-encoded inline; universal but
#     size-limited. Measured on the decoded (original) file. Default 5 MiB.
HATCHDOOR_MCP_MAX_BASE64_BYTES=5242880
#   - POST /api/attachment (multipart) is used by the web UI and by agents that
#     can make an HTTP request; use it for larger files. Default 10 MiB.
HATCHDOOR_MAX_ATTACHMENT_BYTES=10485760

# Automatic git sync of the vault (off by default). When enabled, successful MCP
# write tools commit and push vault changes to the configured remote.
HATCHDOOR_GIT_SYNC_ENABLED=false
# Remote name (URL comes from the repo's existing remote config).
HATCHDOOR_GIT_REMOTE=origin
# Branch to commit and push. Must match the repo's current branch.
HATCHDOOR_GIT_BRANCH=main
# HTTPS auth. Token is required when sync is enabled; never logged.
HATCHDOOR_GIT_HTTPS_USERNAME=hatchdoor
HATCHDOOR_GIT_HTTPS_TOKEN=
# Quiet window (seconds) before a batch of writes is committed and pushed.
HATCHDOOR_GIT_DEBOUNCE_SECONDS=30
# Commit identity.
HATCHDOOR_GIT_AUTHOR_NAME=Hatchdoor
HATCHDOOR_GIT_AUTHOR_EMAIL=hatchdoor@localhost

# Logging.
RUST_LOG=hatchdoor=info,tower_http=info,axum::rejection=warn
