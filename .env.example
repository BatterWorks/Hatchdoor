# Copy this file to .env. Every value is optional: Hatchdoor and Docker Compose
# provide the defaults shown below. Uncomment only the values you need to pin.

# Docker Compose host mounts. These paths are read by Compose on the host.
# HOST_VAULT_PATH=/absolute/path/to/your/markdown-vault
# HOST_CACHE_PATH=./data/cache
# HOST_STATE_PATH=./data/state
# HOST_MODELS_PATH=./models

# Server and storage (environment-only). Docker Compose fixes these container
# paths and the published port; use these only when running Hatchdoor directly.
# VAULT_PATH=./vault
# HATCHDOOR_CACHE_DB=./data/cache/hatchdoor-cache.sqlite3
# HOST=127.0.0.1
# PORT=42824
# HATCHDOOR_SETTINGS_FILE=/path/outside/your/vault/settings.json

# Web access (environment-only). A Docker first run without this token prints a
# fresh token and the exact assignment to add here. Demo mode is browse-only.
# HATCHDOOR_WEB_BEARER_TOKEN=
# HATCHDOOR_DEMO_MODE=false

# Settings — Vault. Leave these unset to manage them live in Settings. A
# non-empty .env value pins that one setting until it is removed and restarted.
# HATCHDOOR_ARCHIVE_PREFIX=90-archive/
# HATCHDOOR_EXCLUDE=imports/,*.bak
# HATCHDOOR_EMBED_LAYERS=true

# Settings — Agent access (MCP). MCP stays disabled until enabled in Settings;
# it always needs its own bearer token, even for read-only access.
# HATCHDOOR_MCP_ENABLED=false
# HATCHDOOR_MCP_WRITE_ENABLED=false
# HATCHDOOR_MCP_BEARER_TOKEN=
# HATCHDOOR_MCP_ALLOWED_ORIGINS=http://127.0.0.1,http://localhost

# Settings — Uploads. Limits are bytes (10 MiB for web uploads, 5 MiB inline).
# HATCHDOOR_MAX_ATTACHMENT_BYTES=10485760
# HATCHDOOR_MCP_MAX_BASE64_BYTES=5242880

# Settings — Versioning. These values can be applied live in Settings.
# HATCHDOOR_GIT_SYNC_ENABLED=false
# HATCHDOOR_GIT_HTTPS_USERNAME=hatchdoor
# HATCHDOOR_GIT_HTTPS_TOKEN=
# HATCHDOOR_GIT_DEBOUNCE_SECONDS=30
# HATCHDOOR_GIT_AUTHOR_NAME=Hatchdoor
# HATCHDOOR_GIT_AUTHOR_EMAIL=hatchdoor@localhost

# Versioning deployment pins. The remote and branch must match the existing
# vault repository; Settings never changes them.
# HATCHDOOR_GIT_REMOTE=origin
# HATCHDOOR_GIT_BRANCH=main

# Logging (environment-only).
# RUST_LOG=hatchdoor=info,tower_http=info,axum::rejection=warn
